# Never expose this value to the proposal/LLM layer.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Test mode only. When unset, RecoverOS uses an explicitly labeled simulated executor.
RAZORPAY_TEST_MODE=true
GROQ_API_KEY=
RECOVEROS_LLM_DIAGNOSIS_MODEL=
RECOVEROS_LLM_NARRATION_MODEL=
RECOVEROS_LLM_DISABLED=

# Voice loop: Twilio places the call; the spoken answer and ElevenLabs audio need a public URL.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
ELEVENLABS_API_KEY=
# e.g. the https URL printed by `ngrok http 3000`
PUBLIC_BASE_URL=

# Set to 1 to disable the TRAI quiet-hours gate on this server only (for recording a demo after 21:00 IST). Leave empty in production.
RECOVEROS_DISABLE_QUIET_HOURS=
